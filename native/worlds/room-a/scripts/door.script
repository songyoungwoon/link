// A callback's let values are local; store belongs to this binding instance.
on onStart(ctx) {
  store clicks = 0;
}

on onInteract(ctx, event) {
  let open = !ctx.getState().isOpen;
  clicks = clicks + 1;
  ctx.setState({isOpen: open, clicks: clicks});
  ctx.setState(ctx.find(ctx.config.owner), {isOpen: open});
  if (open) { ctx.log("Door opening"); }
  else { ctx.log("Door closing"); }
}

on onUpdate(ctx, deltaSeconds) {
  let target = 0;
  if (ctx.getState().isOpen) { target = ctx.config.openAngle; }
  let rotation = ctx.getTransform().rotation;
  let step = clamp(target - rotation[1], -ctx.config.speed * deltaSeconds, ctx.config.speed * deltaSeconds);
  ctx.setTransform({rotation: [0, rotation[1] + step, 0]});
}

on onDestroy(ctx) {
  ctx.log("Door binding destroyed");
}
